language-Bee-description = Bzzzzzzzzz zzz bzzzz bzz b-bzzzz bzzz bzzzzzzzzzzzzzzz.

language-Cat-name = Felidae.

language-Cat-description = A proto-língua usada principalmente por felides, como gatos de casa ou leões.

language-Dog-name = Canini.

language-Dog-description = A proto-língua usada principalmente por animais "como cães", como corgis e lobos.

language-Fox-name =  Vulpini.

language-Fox-description = A proto-língua usada principalmente por animais "como raposas"...

language-Xeno-name = Xeno.

language-Xeno-description = Sssss!

language-Monkey-name = Simian.

language-Monkey-description = A proto-língua usada principalmente por antropóides, como macacos e macacos.

language-Mouse-name = Rato

language-Mouse-description =  Aperte!

language-Chicken-name = Galinha.

language-Chicken-description = Coot!

language-Duck-name = Pato.

language-Duck-description = Quack!

language-Cow-name = Vaca.

language-Cow-description = Moooo!

language-Sheep-name = Ovelhas

language-Sheep-description = Baaah!

language-Kangaroo-name = Canguru

language-Kangaroo-description = Chuu!

language-Pig-name = Porco.

language-Pig-description = Oink!

language-Crab-name = Caranguejo

language-Crab-description =  Clique!

language-Kobold-name =  Draconic

language-Kobold-description =  Ao contrário de outras línguas, alguns unathi ainda falam até hoje.

language-Hissing-name = Assobiando

language-Hissing-description = Hiss!

# Floof section begin
language-ScugSign-name = ScugSign

language-ScugSign-description = Wawa, o secreto ScugSign, fazendo você entender seus companheiros desprezíveis!

language-Scurret-name = -Scurret.

language-Scurret-description =  Uma proto-língua bonita falada pelos cornos.

language-Arachnic-name = Aracnic

language-Arachnic-description = A linguagem dos aracnídeos é composta de cliques e assobios, quase tem um caráter rítmico às vezes.

language-Penguin-name = Pinguim

language-Penguin-description = -Batida!

language-Eldritch-name = Eldritch

language-Eldritch-description =  Uma linguagem que é considerada esquecida há muito tempo. Agora, os únicos falantes desta língua profana de gritos e murmúrios são os seguidores de um antigo Deus de Sangue.
