borg-type-quadgeneric-name = Quad genérico.

borg-type-quadgeneric-desc =  Faça várias tarefas aleatórias na estação, ou talvez ajude o departamento de ciências que o construiu.

borg-type-quadgeneric-transponder = cyborg genérico

borg-type-quadsecurity-name = Quad da segurança.

borg-type-quadsecurity-desc =  Ajudar a segurança na luta pela justiça, prendendo criminosos perigosos.

borg-type-quadsecurity-transponder = cyborg de segurança

borg-type-quadengineering-name = Quad de Engenharia

borg-type-quadengineering-desc =  Ajude a equipe de engenharia na construção da estação, reparar danos, ou consertar problemas elétricos e atmosféricos.

borg-type-quadengineering-transponder =  engenharia cyborg

borg-type-quadmining-name =  Quadrante de Salvagem

borg-type-quadmining-desc =  Junte-se ao salvamento e ajude-os a pegar materiais, procurar destroços e lutar contra a vida selvagem hostil.

borg-type-quadmining-transponder = cyborg de salvamento

borg-type-quadjanitor-name = Zelador Quad.

borg-type-quadjanitor-desc =  Mantenha a estação bem arrumada, limpe os vazamentos, recolha e descarte corretamente o lixo deixado por membros preguiçosos da tripulação.

borg-type-quadjanitor-transponder =  zelador cyborg

borg-type-quadmedical-name = Quad médico

borg-type-quadmedical-desc =  Prestar atenção médica à tripulação que precisa, seja em Medbay ou em áreas perigosas que os paramédicos convencionais não podem alcançar.

borg-type-quadmedical-transponder = Ciborgue médico

borg-type-quadservice-name =  Serviço Quad

borg-type-quadservice-desc =  Ajuda com uma grande variedade de serviços de equipe, que vão desde servir lanches e bebidas a botânica a entretenimento.

borg-type-quadservice-transponder =  serviço de cyborg
