# My god, people, stop copy-pasting loc strings
trait-Chittin-name = Chittin.

trait-Chittin-desc =
    { language-Chittin-description }
     Através de alguma adaptação, aumento ou solução inteligente, você fala isso.

trait-Nehina-name = Nehina.

trait-Nehina-desc =  Uma língua falada pelos Feroxi, bem adaptada para falar sob as águas dos planetas oceânicos.

trait-Mouse-name = Rato

trait-Mouse-desc =  Uma linguagem rangente conhecida pela Rodentia, muitas outras espécies de roedores e ratos padrão, é composta por rangers curtos e afiados.

trait-Canilunzt-name = Canilunzt

trait-Canilunzt-desc = A linguagem gutural falada e utilizada pelos habitantes do sistema Vazzend, composta por rosnados, latidos, yaps, e uso pesado de orelhas e movimentos de cauda.

trait-Arachnic-name = Aracnic

trait-Arachnic-desc = A linguagem dos aracnídeos é composta de cliques e assobios, quase tem um caráter rítmico às vezes.

trait-RootSpeak-name = RootSpeak

trait-RootSpeak-desc = A estranha língua falada pelo Diona.

trait-Moffic-name = Moffic.

trait-Moffic-desc = A linguagem dos mariposos, limita-se à ininteligibilidade total.

trait-Draconic-name = SINTA'Unathi

trait-Draconic-desc = A língua de Moghes, falada nativamente pelos Unathi, composta de sibilantes assobios e chocalhos.

trait-Bubblish-name = Bubblish

trait-Bubblish-desc =  Sendo uma mistura de ruídos borbulhantes e pops é muito difícil falar pelos humanos sem o uso de aparelhos mecânicos, através de alguma adaptação, aumento ou trabalho inteligente, você fala isso.

trait-Schechi-name = Schechi.

trait-Schechi-desc = A linguagem de Resomi, principalmente com sons frontais feitos sem arredondamentos.

trait-Nekomimetic-name = Nekomimética

trait-Nekomimetic-desc = Para o observador casual, esta linguagem é uma confusão incompreensível de japonês quebrado para os Felinids e Oni, de alguma forma, é compreensível.

trait-Kagebun-name = Kagebun

trait-Kagebun-desc =  Uma língua antiga usada principalmente pelos yōkai, originada de suas raízes sobrenaturais, é um coro de sons que vão desde sussurros estranhos até cânticos ritualísticos, para aqueles que falam, é uma língua viva que os liga ao mundo espiritual e seus pactos antigos.

trait-Binary-name = Binário acústico

trait-Binary-desc =
    { language-Binary-description }
     Através de alguma adaptação, aumento ou solução inteligente, você fala isso.

trait-NalRasan-name = Nal'rasan (Idioma de Sinais de Tajara)

trait-NalRasan-desc =  Uma linguagem focada no corpo, Nal'rasan foi desenvolvida para se comunicar discretamente entre as partes, porque expressões vocais e murmurantes às vezes poderiam alertar as presas para a presença de caçadores e afastá-las, grupos de caça adotaram essa linguagem para evitar que tal coisa ocorresse.

trait-SiikTajr-name = Siik'tajr

trait-SiikTajr-desc =  Uma linguagem moderna para aqueles com orelhas e caudas expressivas, combinando vocalizações com linguagem corporal.

trait-SolCommon-name = Sol Common

trait-SolCommon-desc = { language-SolCommon-description }

trait-ValyrianStandard-name =  Padrão Valíriano

trait-ValyrianStandard-desc = { language-ValyrianStandard-description }

# Not yet implemented
trait-Bilingual-name = Bilíngue.

trait-Bilingual-desc =  Ao criar ou por imersão, você aprendeu mais línguas do que a maioria, você é capaz de falar duas línguas além da sua língua nativa.

trait-Trilingual-name = Trilíngue.

trait-Trilingual-desc =  Você é bem viajado ou teve uma educação muito diversificada, você é capaz de falar três línguas além da sua língua nativa.

trait-Quadrilingual-name = Quadrilíngue.

trait-Quadrilingual-desc =  Você já foi a mais lugares do que pode contar, e aprendeu mais do que algumas línguas ao longo do caminho.
